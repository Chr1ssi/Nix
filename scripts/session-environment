#!/usr/bin/env bash
set -euo pipefail

: "${WAYLAND_DISPLAY:?Muss innerhalb der River-Sitzung ausgeführt werden}"
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=mywm
export XDG_SESSION_TYPE=wayland
# Explicitly clear a previous session's X display if Xwayland is disabled.
export DISPLAY=${DISPLAY:-}
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
# These three portal services are enabled by desktop.nix.
portals=(xdg-desktop-portal-wlr.service xdg-desktop-portal-gtk.service xdg-desktop-portal.service)
# Newly installed units may not have been loaded yet.
systemctl --user reset-failed "${portals[@]}" 2>/dev/null || true
systemctl --user --no-block restart "${portals[@]}"
# Home Manager attaches desktop applications to this target. Custom Wayland
# sessions do not start it automatically like the larger desktop environments.
systemctl --user start graphical-session.target
